{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>LouisLetcher/factory"],
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "description": "Profile tooling only: auto-merge non-major updates once CI is green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
