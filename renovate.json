{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "One grouped PR per week keeps CI minutes low.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "description": "Profile tooling only: auto-merge non-major updates once CI is green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
